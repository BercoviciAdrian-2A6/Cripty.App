<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="CriptyBackgroundColor">#07110D</Color>
        <Color x:Key="CriptySurfaceColor">#0B1812</Color>
        <Color x:Key="CriptySurfaceRaisedColor">#10241A</Color>
        <Color x:Key="CriptyBorderColor">#28533C</Color>
        <Color x:Key="CriptyBorderBrightColor">#4C9A69</Color>
        <Color x:Key="CriptyTextColor">#D9F8E4</Color>
        <Color x:Key="CriptyTextMutedColor">#7FA68C</Color>
        <Color x:Key="CriptyAccentColor">#71F79F</Color>
        <Color x:Key="CriptyAccentDarkColor">#173E28</Color>
        <Color x:Key="CriptyDangerColor">#FF9B72</Color>

        <SolidColorBrush x:Key="CriptyBackgroundBrush"
                         Color="{StaticResource CriptyBackgroundColor}" />
        <SolidColorBrush x:Key="CriptySurfaceBrush"
                         Color="{StaticResource CriptySurfaceColor}" />
        <SolidColorBrush x:Key="CriptySurfaceRaisedBrush"
                         Color="{StaticResource CriptySurfaceRaisedColor}" />
        <SolidColorBrush x:Key="CriptyBorderBrush"
                         Color="{StaticResource CriptyBorderColor}" />
        <SolidColorBrush x:Key="CriptyBorderBrightBrush"
                         Color="{StaticResource CriptyBorderBrightColor}" />
        <SolidColorBrush x:Key="CriptyTextBrush"
                         Color="{StaticResource CriptyTextColor}" />
        <SolidColorBrush x:Key="CriptyTextMutedBrush"
                         Color="{StaticResource CriptyTextMutedColor}" />
        <SolidColorBrush x:Key="CriptyAccentBrush"
                         Color="{StaticResource CriptyAccentColor}" />
        <SolidColorBrush x:Key="CriptyAccentDarkBrush"
                         Color="{StaticResource CriptyAccentDarkColor}" />
        <SolidColorBrush x:Key="CriptyDangerBrush"
                         Color="{StaticResource CriptyDangerColor}" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background"
                Value="{StaticResource CriptyBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <!-- TextBox -->

    <Style Selector="TextBox">
        <Setter Property="Background"
                Value="#09150F" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
        <Setter Property="PlaceholderForeground"
                Value="{StaticResource CriptyTextMutedBrush}" />
        <Setter Property="CaretBrush"
                Value="{StaticResource CriptyAccentBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="3" />
        <Setter Property="Padding"
                Value="14,11" />
    </Style>

    <!-- Apply the normal colours to Fluent's internal TextBox border. -->

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background"
                Value="#09150F" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrush}" />
    </Style>

    <!-- TextBox hover -->

    <Style Selector="TextBox:pointerover">
        <Setter Property="Background"
                Value="{StaticResource CriptySurfaceRaisedBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
        <Setter Property="PlaceholderForeground"
                Value="{StaticResource CriptyTextMutedBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrightBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"
                Value="{StaticResource CriptySurfaceRaisedBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrightBrush}" />
    </Style>

    <!-- TextBox focused/active -->

    <Style Selector="TextBox:focus">
        <Setter Property="Background"
                Value="{StaticResource CriptySurfaceRaisedBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
        <Setter Property="PlaceholderForeground"
                Value="{StaticResource CriptyTextMutedBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyAccentBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"
                Value="{StaticResource CriptySurfaceRaisedBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyAccentBrush}" />
        <Setter Property="BorderThickness"
                Value="2" />
    </Style>

    <!-- TextBox disabled -->

    <Style Selector="TextBox:disabled">
        <Setter Property="Background"
                Value="#0A130F" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
        <Setter Property="PlaceholderForeground"
                Value="#587160" />
        <Setter Property="BorderBrush"
                Value="#173322" />
    </Style>

    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background"
                Value="#0A130F" />
        <Setter Property="BorderBrush"
                Value="#173322" />
    </Style>

    <!-- Normal button -->

    <Style Selector="Button">
        <Setter Property="Background"
                Value="{StaticResource CriptySurfaceRaisedBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="3" />
        <Setter Property="Padding"
                Value="16,10" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <!-- Normal button hover -->

    <Style Selector="Button:pointerover">
        <Setter Property="Background"
                Value="#173322" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrightBrush}" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"
                Value="#173322" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <Style Selector="Button:pointerover TextBlock">
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <!-- Normal button pressed -->

    <Style Selector="Button:pressed">
        <Setter Property="Background"
                Value="{StaticResource CriptyAccentDarkBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyAccentBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"
                Value="{StaticResource CriptyAccentDarkBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <Style Selector="Button:pressed TextBlock">
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextBrush}" />
    </Style>

    <!-- Primary button -->

    <Style Selector="Button.primary">
        <Setter Property="Background"
                Value="{StaticResource CriptyAccentBrush}" />
        <Setter Property="Foreground"
                Value="#07110D" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyAccentBrush}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground"
                Value="#07110D" />
    </Style>

    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground"
                Value="#07110D" />
    </Style>

    <!-- Primary button hover -->

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background"
                Value="#9AFFBC" />
        <Setter Property="Foreground"
                Value="#07110D" />
        <Setter Property="BorderBrush"
                Value="#9AFFBC" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"
                Value="#9AFFBC" />
        <Setter Property="Foreground"
                Value="#07110D" />
    </Style>

    <Style Selector="Button.primary:pointerover TextBlock">
        <Setter Property="Foreground"
                Value="#07110D" />
    </Style>

    <!-- Primary button pressed -->

    <Style Selector="Button.primary:pressed">
        <Setter Property="Background"
                Value="#58D985" />
        <Setter Property="Foreground"
                Value="#07110D" />
        <Setter Property="BorderBrush"
                Value="#58D985" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"
                Value="#58D985" />
        <Setter Property="Foreground"
                Value="#07110D" />
    </Style>

    <Style Selector="Button.primary:pressed TextBlock">
        <Setter Property="Foreground"
                Value="#07110D" />
    </Style>

    <!-- Ghost button -->

    <Style Selector="Button.ghost">
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <!-- Disabled button -->

    <Style Selector="Button:disabled">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Background"
                Value="#0D1A13" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrush}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Background"
                Value="#0D1A13" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <Style Selector="Button:disabled TextBlock">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <!-- Disabled ghost button -->

    <Style Selector="Button.ghost:disabled">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <Style Selector="Button.ghost:disabled TextBlock">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <!-- Disabled primary button -->

    <Style Selector="Button.primary:disabled">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Background"
                Value="#13251A" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CriptyBorderBrush}" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Background"
                Value="#13251A" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <Style Selector="Button.primary:disabled TextBlock">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Foreground"
                Value="{StaticResource CriptyTextMutedBrush}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground"
                Value="{StaticResource CriptyAccentBrush}" />
        <Setter Property="Background"
                Value="#13291C" />
    </Style>

    <Style Selector="Button.password-toggle">
    <Setter Property="MinWidth"
            Value="54" />
    <Setter Property="Margin"
            Value="6,0,0,0" />
    <Setter Property="Padding"
            Value="8,5" />
    <Setter Property="Background"
            Value="#0D1A13" />
    <Setter Property="Foreground"
            Value="{StaticResource CriptyTextMutedBrush}" />
    <Setter Property="BorderBrush"
            Value="{StaticResource CriptyBorderBrush}" />
    <Setter Property="FontSize"
            Value="9" />
    <Setter Property="FontWeight"
            Value="SemiBold" />
</Style>

<Style Selector="Button.password-toggle:pointerover">
    <Setter Property="Background"
            Value="#173322" />
    <Setter Property="Foreground"
            Value="{StaticResource CriptyAccentBrush}" />
    <Setter Property="BorderBrush"
            Value="{StaticResource CriptyBorderBrightBrush}" />
</Style>

<Style Selector="Button.password-toggle:pressed">
    <Setter Property="Background"
            Value="{StaticResource CriptyAccentDarkBrush}" />
    <Setter Property="Foreground"
            Value="{StaticResource CriptyTextBrush}" />
    <Setter Property="BorderBrush"
            Value="{StaticResource CriptyAccentBrush}" />
</Style>

</Styles>