<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             x:Class="Cripty.Views.MainVaultView"
             x:DataType="vm:MainVaultViewModel">

    <Grid Background="{StaticResource CriptyBackgroundBrush}"
          RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="48,20"
                BorderBrush="{StaticResource CriptyBorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="CRIPTY"
                               FontSize="22"
                               FontWeight="Bold"
                               LetterSpacing="4"
                               Foreground="{StaticResource CriptyAccentBrush}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="7">
                        <TextBlock Text="OPEN VAULT:"
                                   FontSize="10"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBlock Text="{Binding VaultName}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.2"
                                   Foreground="{StaticResource CriptyTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="ghost"
                        Command="{Binding LockVaultCommand}"
                        VerticalAlignment="Center">

                    <TextBlock Text="LOCK VAULT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               LetterSpacing="1.2" />
                </Button>
            </Grid>
        </Border>

        <!-- Main vault layout goes here later. -->
        <Grid Grid.Row="1" />

    </Grid>
</UserControl>