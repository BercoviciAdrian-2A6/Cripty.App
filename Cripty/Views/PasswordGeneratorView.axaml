<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             x:Class="Cripty.Views.PasswordGeneratorView"
             x:DataType="vm:PasswordGeneratorDialogViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Border Background="#E607110D">
        <Border Width="610"
                MaxHeight="720"
                Margin="24"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CriptySurfaceBrush}"
                BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                BorderThickness="1"
                CornerRadius="5">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="19">
                    <StackPanel Spacing="5">
                        <TextBlock Text="GENERATE PASSWORD"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="Choose a character set and a target security level. The result uses enough uniformly random characters to meet or exceed the requested entropy."
                                   FontSize="10"
                                   LineHeight="16"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="CHARACTER SET"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.2"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <ComboBox ItemsSource="{Binding CharacterSetOptions}"
                                  SelectedItem="{Binding SelectedCharacterSet, Mode=TwoWay}"
                                  HorizontalContentAlignment="Stretch">

                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PasswordCharacterSetOptionViewModel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="0.6" />

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="8"
                                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedCharacterSet.Description}"
                                   FontSize="9"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TARGET SECURITY"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.2"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="Enter any whole number from 1 to 256 bits."
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  ColumnDefinitions="Auto,Auto"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center">

                                <NumericUpDown Width="105"
                                               Minimum="1"
                                               Maximum="256"
                                               Increment="1"
                                               FormatString="0"
                                               Value="{Binding SecurityBits, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1"
                                           Text="BITS"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </Grid>

                        <ProgressBar Minimum="1"
                                     Maximum="256"
                                     Value="{Binding SecurityProgressValue}"
                                     Height="10"
                                     Foreground="{Binding SecurityIndicatorBrush}"
                                     Background="#111B17" />

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding SecurityRatingText}"
                                       Foreground="{Binding SecurityIndicatorBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="1" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SecurityGuidanceText}"
                                       Margin="12,0,0,0"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       FontSize="9"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <Border Padding="13"
                            Background="#0B1912"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="GENERATED OUTPUT"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.1"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="{Binding OutputSummaryText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="CSPRNG"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Printable ASCII without whitespace contains 94 characters: ! through ~. The omitted 95th printable ASCII character is space."
                               FontSize="8"
                               LineHeight="13"
                               Foreground="{StaticResource CriptyTextMutedBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,8,0">

                            <TextBlock Text="CANCEL"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary"
                                Command="{Binding GenerateCommand}">

                            <TextBlock Text="GENERATE PASSWORD"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</UserControl>
