<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             x:Class="Cripty.Views.PasswordInspectorView"
             x:DataType="vm:PasswordInspectorDialogViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Styles>
        <Style Selector="Border.inspector-character">
            <Setter Property="Width"
                    Value="78" />
            <Setter Property="MinHeight"
                    Value="132" />
            <Setter Property="Margin"
                    Value="4" />
            <Setter Property="Padding"
                    Value="8" />
            <Setter Property="Background"
                    Value="#17211D" />
            <Setter Property="BorderBrush"
                    Value="#3B4A42" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="4" />
        </Style>

        <Style Selector="Border.inspector-character.number">
            <Setter Property="Background"
                    Value="#17283A" />
            <Setter Property="BorderBrush"
                    Value="#42698C" />
        </Style>

        <Style Selector="Border.inspector-character.lowercase">
            <Setter Property="Background"
                    Value="#14352D" />
            <Setter Property="BorderBrush"
                    Value="#397765" />
        </Style>

        <Style Selector="Border.inspector-character.uppercase">
            <Setter Property="Background"
                    Value="#36311B" />
            <Setter Property="BorderBrush"
                    Value="#82743E" />
        </Style>

        <Style Selector="Border.inspector-character.symbol">
            <Setter Property="Background"
                    Value="#33233B" />
            <Setter Property="BorderBrush"
                    Value="#76518A" />
        </Style>

        <Style Selector="Border.legend-chip">
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="Margin"
                    Value="0,0,7,0" />
            <Setter Property="CornerRadius"
                    Value="3" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style Selector="Border.legend-chip.number">
            <Setter Property="Background"
                    Value="#17283A" />
            <Setter Property="BorderBrush"
                    Value="#42698C" />
        </Style>

        <Style Selector="Border.legend-chip.lowercase">
            <Setter Property="Background"
                    Value="#14352D" />
            <Setter Property="BorderBrush"
                    Value="#397765" />
        </Style>

        <Style Selector="Border.legend-chip.uppercase">
            <Setter Property="Background"
                    Value="#36311B" />
            <Setter Property="BorderBrush"
                    Value="#82743E" />
        </Style>

        <Style Selector="Border.legend-chip.symbol">
            <Setter Property="Background"
                    Value="#33233B" />
            <Setter Property="BorderBrush"
                    Value="#76518A" />
        </Style>
    </UserControl.Styles>

    <Border Background="#E607110D">
        <Border Width="760"
                MaxHeight="720"
                Margin="24"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CriptySurfaceBrush}"
                BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                BorderThickness="1"
                CornerRadius="5">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="5">
                        <TextBlock Text="INSPECT PASSWORD"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="Read the password in small groups. Every character is numbered and explicitly classified so similar shapes are not the only clue."
                                   FontSize="10"
                                   LineHeight="16"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Padding="12"
                            Background="#0B1912"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding PageRangeText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CriptyAccentBrush}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CharacterCountText}"
                                       Margin="16,0,0,0"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VisibleCharacters}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PasswordInspectorCharacterViewModel">
                                <Border Classes="inspector-character"
                                        Classes.number="{Binding IsNumber}"
                                        Classes.lowercase="{Binding IsLowercase}"
                                        Classes.uppercase="{Binding IsUppercase}"
                                        Classes.symbol="{Binding IsSymbol}">

                                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                                        <TextBlock Text="{Binding PositionText}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayValue}"
                                                   Margin="0,6"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   FontSize="28"
                                                   FontWeight="Bold" />

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding CategoryKeyText}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold" />

                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding CategoryText}"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="7"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="0.5" />

                                        <TextBlock Grid.Row="4"
                                                   Text="{Binding CodePointText}"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="7"
                                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Orientation="Horizontal">
                        <Border Classes="legend-chip number">
                            <TextBlock Text="0–9  NUMBER"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Border Classes="legend-chip lowercase">
                            <TextBlock Text="a–z  LOWERCASE"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Border Classes="legend-chip uppercase">
                            <TextBlock Text="A–Z  UPPERCASE"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Border Classes="legend-chip symbol">
                            <TextBlock Text="# / ?  SYMBOL"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Text="{Binding PageNumberText}"
                                   VerticalAlignment="Center"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <Button Grid.Column="2"
                                Classes="ghost"
                                Command="{Binding MovePreviousPageCommand}"
                                Margin="0,0,8,0">

                            <TextBlock Text="PREVIOUS"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="3"
                                Classes="ghost"
                                Command="{Binding MoveNextPageCommand}">

                            <TextBlock Text="NEXT"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Close the inspector when you are finished to reduce on-screen exposure."
                                   VerticalAlignment="Center"
                                   FontSize="8"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />

                        <Button Grid.Column="1"
                                Classes="primary"
                                Command="{Binding CloseCommand}"
                                Margin="16,0,0,0">

                            <TextBlock Text="CLOSE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</UserControl>
