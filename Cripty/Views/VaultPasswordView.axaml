<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             x:Class="Cripty.Views.VaultPasswordView"
             x:DataType="vm:VaultPasswordViewModel">

    <Grid Background="{StaticResource CriptyBackgroundBrush}"
          RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="48,24"
                BorderBrush="{StaticResource CriptyBorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="CRIPTY"
                               FontSize="24"
                               FontWeight="Bold"
                               LetterSpacing="4"
                               Foreground="{StaticResource CriptyAccentBrush}" />

                    <TextBlock Text="ENCRYPTED VAULT TERMINAL"
                               FontSize="11"
                               LetterSpacing="2"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,7"
                        Background="#0B1D13"
                        BorderBrush="{StaticResource CriptyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding ModeText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               LetterSpacing="1"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <Border Width="560"
                    Margin="48,34,48,44"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="22">

                    <Button Classes="ghost"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            Padding="8,6">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">

                            <TextBlock Text="‹"
                                       FontSize="18"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="BACK"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="8">

                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="{Binding DescriptionText}"
                                   FontSize="13"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <Border Padding="13"
                            Background="#0A1C12"
                            BorderBrush="#1B3828"
                            BorderThickness="1"
                            CornerRadius="3">

                        <StackPanel Spacing="4">

                            <TextBlock Text="{Binding VaultName}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="{Binding VaultDirectoryPath}"
                                       FontSize="11"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Main password field -->
                    <StackPanel Spacing="7">

                        <TextBlock Text="PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBox Text="{Binding Password,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="●"
                                 RevealPassword="{Binding IsPasswordVisible}"
                                 MaxLength="1024"
                                 Watermark="Enter vault password">

                            <TextBox.InnerRightContent>
                                <Button Classes="password-toggle"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        Content="{Binding PasswordVisibilityActionText}"
                                        ToolTip.Tip="Show or hide the password" />
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <TextBlock Text="{Binding PasswordCharacterCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="9"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <!-- Confirmation field, shown only during creation -->
                    <StackPanel Spacing="7"
                                IsVisible="{Binding IsCreateMode}">

                        <TextBlock Text="CONFIRM PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBox Text="{Binding ConfirmPassword,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="●"
                                 RevealPassword="{Binding IsConfirmPasswordVisible}"
                                 MaxLength="1024"
                                 Watermark="Enter the password again">

                            <TextBox.InnerRightContent>
                                <Button Classes="password-toggle"
                                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                        Content="{Binding ConfirmPasswordVisibilityActionText}"
                                        ToolTip.Tip="Show or hide the confirmation password" />
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <TextBlock Text="{Binding ConfirmPasswordCharacterCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="9"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <Border IsVisible="{Binding HasError}"
                            Padding="12"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border IsVisible="{Binding IsCreateMode}"
                            Padding="12"
                            Background="#0A1C12"
                            BorderBrush="#1B3828"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="Cripty cannot recover this password. Losing it means losing access to the vault."
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Classes="primary"
                            Command="{Binding SubmitCommand}"
                            HorizontalContentAlignment="Center">

                        <TextBlock Text="{Binding PrimaryActionText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.2" />
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>