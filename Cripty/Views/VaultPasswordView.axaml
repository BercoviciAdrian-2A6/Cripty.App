<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             xmlns:views="using:Cripty.Views"
             x:Class="Cripty.Views.VaultPasswordView"
             x:DataType="vm:VaultPasswordViewModel">

    <Grid Background="{StaticResource CriptyBackgroundBrush}"
          RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="48,24"
                BorderBrush="{StaticResource CriptyBorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="CRIPTY"
                               FontSize="24"
                               FontWeight="Bold"
                               LetterSpacing="4"
                               Foreground="{StaticResource CriptyAccentBrush}" />

                    <TextBlock Text="ENCRYPTED VAULT TERMINAL"
                               FontSize="11"
                               LetterSpacing="2"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,7"
                        Background="#0B1D13"
                        BorderBrush="{StaticResource CriptyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding ModeText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               LetterSpacing="1"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <Border Width="560"
                    Margin="48,34,48,44"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="22">

                    <Button Classes="ghost"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            Padding="8,6">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">
                            <TextBlock Text="‹"
                                       FontSize="18"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="BACK"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="{Binding DescriptionText}"
                                   FontSize="13"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <Border Padding="13"
                            Background="#0A1C12"
                            BorderBrush="#1B3828"
                            BorderThickness="1"
                            CornerRadius="3">

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding VaultName}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="{Binding VaultDirectoryPath}"
                                       FontSize="11"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="7">
                        <TextBlock Text="PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBox Text="{Binding Password,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 CaretIndex="{Binding PasswordCaretIndex, Mode=TwoWay}"
                                 PasswordChar="{Binding PasswordMaskCharacter}"
                                 MaxLength="1024"
                                 Watermark="Enter vault password">

                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <Button Classes="password-toggle"
                                            Focusable="False"
                                            Content="Ă"
                                            ToolTip.Tip="Insert an extended Latin letter at the caret">

                                        <Button.Flyout>
                                            <Flyout>
                                                <views:ExtendedLatinCharacterPickerView
                                                    CharacterSelected="InsertPasswordSpecialCharacter" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button Classes="password-toggle"
                                            Focusable="False"
                                            Command="{Binding TogglePasswordVisibilityCommand}"
                                            Content="{Binding PasswordVisibilityActionText}"
                                            ToolTip.Tip="Show or hide the password" />
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <TextBlock Text="{Binding PasswordCharacterCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="9"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="7"
                                IsVisible="{Binding IsCreateMode}">
                        <TextBlock Text="CONFIRM PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBox Text="{Binding ConfirmPassword,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 CaretIndex="{Binding ConfirmPasswordCaretIndex, Mode=TwoWay}"
                                 PasswordChar="{Binding ConfirmPasswordMaskCharacter}"
                                 MaxLength="1024"
                                 Watermark="Enter the password again">

                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <Button Classes="password-toggle"
                                            Focusable="False"
                                            Content="Ă"
                                            ToolTip.Tip="Insert an extended Latin letter at the caret">

                                        <Button.Flyout>
                                            <Flyout>
                                                <views:ExtendedLatinCharacterPickerView
                                                    CharacterSelected="InsertConfirmPasswordSpecialCharacter" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button Classes="password-toggle"
                                            Focusable="False"
                                            Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                            Content="{Binding ConfirmPasswordVisibilityActionText}"
                                            ToolTip.Tip="Show or hide the confirmation password" />
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <TextBlock Text="{Binding ConfirmPasswordCharacterCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="9"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <Border IsVisible="{Binding IsCreateMode}"
                            Padding="13"
                            Background="#0A1C12"
                            BorderBrush="#1B3828"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="KEY DERIVATION"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.5"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="{Binding KdfSummaryText}"
                                           FontSize="12"
                                           Foreground="{StaticResource CriptyTextBrush}" />

                                <TextBlock Text="{Binding KdfProfileText}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Command="{Binding OpenKdfSettingsCommand}"
                                    Margin="14,0,0,0"
                                    Padding="12,8"
                                    VerticalAlignment="Center">

                                <TextBlock Text="KDF SETTINGS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasError}"
                            Padding="12"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border IsVisible="{Binding IsCreateMode}"
                            Padding="12"
                            Background="#0A1C12"
                            BorderBrush="#1B3828"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="Cripty cannot recover this password. Losing it means losing access to the vault."
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Classes="primary"
                            Command="{Binding SubmitCommand}"
                            HorizontalContentAlignment="Center">

                        <TextBlock Text="{Binding PrimaryActionText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.2" />
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.RowSpan="2"
                ZIndex="100"
                IsVisible="{Binding IsKdfSettingsOpen}"
                Background="#D907110D">

            <Border Width="620"
                    MaxHeight="650"
                    Margin="32"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Spacing="22">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="ARGON2ID SETTINGS"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />

                                <TextBlock Text="Parameters used to derive the key that protects this vault."
                                           FontSize="12"
                                           Foreground="{StaticResource CriptyTextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    VerticalAlignment="Top"
                                    Background="#0A1C12"
                                    BorderBrush="#1B3828"
                                    BorderThickness="1"
                                    CornerRadius="3">

                                <TextBlock Text="VERSION 1.3"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Border>
                        </Grid>

                        <Border Padding="13"
                                Background="#291B13"
                                BorderBrush="#6B4632"
                                BorderThickness="1"
                                CornerRadius="3">

                            <TextBlock Text="Higher values consume more memory or CPU time during both vault creation and every unlock."
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{StaticResource CriptyDangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="MEMORY"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <TextBlock Text="Memory allocated while deriving the wrapping key."
                                               FontSize="11"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding KdfMemoryValueText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Grid>

                            <Slider Minimum="{Binding MinimumMemorySizeMiB}"
                                    Maximum="{Binding MaximumMemorySizeMiB}"
                                    Value="{Binding DraftMemorySizeMiB, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding MinimumMemorySizeText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaximumMemorySizeText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ITERATIONS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <TextBlock Text="Repeated passes over the configured memory."
                                               FontSize="11"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding KdfIterationsValueText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Grid>

                            <Slider Minimum="{Binding MinimumIterations}"
                                    Maximum="{Binding MaximumIterations}"
                                    Value="{Binding DraftIterations, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding MinimumIterationsText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaximumIterationsText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="PARALLELISM"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <TextBlock Text="CPU lanes used for performance tuning; it is not a direct strength setting."
                                               FontSize="11"
                                               Foreground="{StaticResource CriptyTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding KdfParallelismValueText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Grid>

                            <Slider Minimum="{Binding MinimumParallelism}"
                                    Maximum="{Binding MaximumParallelism}"
                                    Value="{Binding DraftParallelism, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding MinimumParallelismText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaximumParallelismText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Classes="ghost"
                                    Command="{Binding RestoreDefaultKdfSettingsCommand}">

                                <TextBlock Text="RESTORE DEFAULTS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Command="{Binding CancelKdfSettingsCommand}"
                                    Margin="0,0,8,0">

                                <TextBlock Text="CANCEL"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="primary"
                                    Command="{Binding ApplyKdfSettingsCommand}">

                                <TextBlock Text="APPLY"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
