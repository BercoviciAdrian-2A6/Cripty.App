<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             xmlns:model="using:Cripty.Models"
             xmlns:application="using:Cripty.Application.Vaults"
             x:Class="Cripty.Views.VaultSelectionView"
             x:DataType="vm:VaultSelectionViewModel">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background"
                    Value="{StaticResource CriptySurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="5" />
        </Style>

        <Style Selector="Button.vault-row">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="BorderBrush"
                    Value="#1B3828" />
            <Setter Property="CornerRadius"
                    Value="0" />
            <Setter Property="Padding"
                    Value="16,14" />
        </Style>

        <Style Selector="Button.vault-row:pointerover">
            <Setter Property="Background"
                    Value="#11291B" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background"
                    Value="#291B13" />
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyDangerBrush}" />
            <Setter Property="BorderBrush"
                    Value="#6B4632" />
        </Style>

        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background"
                    Value="#48271A" />
            <Setter Property="Foreground"
                    Value="#FFC0A5" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource CriptyBackgroundBrush}"
          RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="48,24"
                BorderBrush="{StaticResource CriptyBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="CRIPTY"
                               FontSize="24"
                               FontWeight="Bold"
                               LetterSpacing="4"
                               Foreground="{StaticResource CriptyAccentBrush}" />

                    <TextBlock Text="ENCRYPTED VAULT TERMINAL"
                               FontSize="11"
                               LetterSpacing="2"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Button Classes="info-action"
                            Command="{Binding OpenCloudDialogCommand}">
                        <TextBlock Text="CLOUD BACKUP"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.1" />
                    </Button>

                    <Border Padding="12,7"
                            Background="#0B1D13"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource CriptyAccentBrush}" />

                            <TextBlock Text="LOCAL MODE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="48,38,48,44"
              ColumnDefinitions="2*,28,1*">

            <Grid Grid.Column="0"
                  RowDefinitions="Auto,18,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                        <TextBlock Text="SELECT A VAULT"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="Choose an encrypted vault stored on this device."
                                   FontSize="13"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="ghost"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <TextBlock Text="↻"
                                       FontSize="17" />

                            <TextBlock Text="REFRESH"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="2"
                        Classes="panel">
                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- Vault-location controls -->
                        <Border Grid.Row="0"
                                Padding="16,12"
                                BorderBrush="#1B3828"
                                BorderThickness="0,0,0,1">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10">
                                        <TextBlock Text="VAULT LOCATION"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="1.5"
                                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                                        <TextBlock Text="{Binding VaultLocationModeText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="1"
                                                   Foreground="{StaticResource CriptyAccentBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding VaultCountText}"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </Grid>

                                <TextBlock Text="{Binding VaultRootPath}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding VaultRootPath}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Classes="ghost"
                                            Padding="12,7"
                                            IsEnabled="{Binding CanChangeVaultLocation}"
                                            Click="ChooseVaultFolder_Click">
                                        <TextBlock Text="CHOOSE FOLDER"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="1" />
                                    </Button>

                                    <Button Classes="ghost"
                                            Padding="12,7"
                                            Command="{Binding UseDefaultVaultLocationCommand}">
                                        <TextBlock Text="USE DEFAULT"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="1" />
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="16,14,16,0"
                                Padding="12"
                                IsVisible="{Binding HasDiscoveryError}"
                                Background="#291B13"
                                BorderBrush="{StaticResource CriptyDangerBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock Text="{Binding DiscoveryError}"
                                       Foreground="{StaticResource CriptyDangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Vaults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="model:VaultListItem">
                                            <Button Classes="vault-row"
                                                    Command="{Binding $parent[UserControl].DataContext.OpenVaultCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="46,*,Auto">
                                                    <Border Width="34"
                                                            Height="34"
                                                            Background="{StaticResource CriptyAccentDarkBrush}"
                                                            BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <TextBlock Text="▰"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="15"
                                                                   Foreground="{StaticResource CriptyAccentBrush}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="3"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold" />

                                                        <TextBlock Text="{Binding DirectoryPath}"
                                                                   MaxWidth="460"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="›"
                                                               Margin="18,0,4,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="24"
                                                               Foreground="{StaticResource CriptyAccentBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel IsVisible="{Binding ShowEmptyState}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <Border Width="54"
                                        Height="54"
                                        Margin="0,0,0,4"
                                        BorderBrush="{StaticResource CriptyBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="27">
                                    <TextBlock Text="◇"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="25"
                                               Foreground="{StaticResource CriptyBorderBrightBrush}" />
                                </Border>

                                <TextBlock Text="NO VAULTS DETECTED"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.5" />

                                <TextBlock Text="Create one to initialize this location."
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </StackPanel>

                            <Border IsVisible="{Binding IsScanning}"
                                    Background="#D907110D">
                                <StackPanel Width="250"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12">
                                    <TextBlock Text="SCANNING VAULT LOCATION"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5" />

                                    <ProgressBar Height="3"
                                                 IsIndeterminate="True" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Classes="panel"
                    Padding="26">
                <Grid RowDefinitions="Auto,24,Auto,12,Auto,*,Auto">
                    <StackPanel Grid.Row="0"
                                Spacing="8">
                        <Border Width="42"
                                Height="42"
                                HorizontalAlignment="Left"
                                Background="{StaticResource CriptyAccentDarkBrush}"
                                BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock Text="+"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="25"
                                       Foreground="{StaticResource CriptyAccentBrush}" />
                        </Border>

                        <TextBlock Text="CREATE NEW VAULT"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="The name becomes the vault's folder name. No files are created until you set its password."
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Spacing="7">
                        <TextBlock Text="VAULT NAME"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBox Text="{Binding NewVaultName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80"
                                 Watermark="e.g. Personal" />
                    </StackPanel>

                    <TextBlock Grid.Row="4"
                               Text="{Binding NewVaultNameError}"
                               IsVisible="{Binding HasNewVaultNameError}"
                               FontSize="11"
                               Foreground="{StaticResource CriptyDangerBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Row="6"
                                Spacing="12">
                        <Border Padding="12"
                                Background="#0A1C12"
                                BorderBrush="#1B3828"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock Text="Your vault will be stored inside the location shown on the left."
                                       FontSize="11"
                                       LineHeight="16"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button Classes="primary"
                                Command="{Binding CreateVaultCommand}"
                                HorizontalContentAlignment="Center">
                            <TextBlock Text="CONTINUE TO PASSWORD"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Locked-vault backup operations. The synchronized folder is a
             normal local folder managed by the user's cloud client. -->
        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsCloudDialogOpen}"
                Background="#D907110D">
            <Border Width="860"
                    MaxHeight="720"
                    Margin="36"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid RowDefinitions="Auto,18,Auto,18,*,16,Auto,16,Auto">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="CLOUD BACKUP"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.5" />

                            <TextBlock Text="Export and restore complete encrypted vault snapshots without unlocking them."
                                       FontSize="12"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CloseCloudDialogCommand}">
                            <TextBlock Text="CLOSE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="14"
                            Background="#09150F"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,7,Auto">
                            <TextBlock Text="SYNCHRONIZED BACKUP FOLDER"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.4"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />

                            <Button Grid.Column="1"
                                    Grid.RowSpan="3"
                                    Classes="ghost"
                                    IsEnabled="{Binding CanChooseCloudFolder}"
                                    Click="ChooseCloudBackupFolder_Click">
                                <TextBlock Text="CHOOSE FOLDER"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding CloudBackupRootPath}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CloudBackupRootPath}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4"
                          ColumnDefinitions="1*,18,1.25*">
                        <Border Grid.Column="0"
                                Padding="16"
                                Background="#09150F"
                                BorderBrush="{StaticResource CriptyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid RowDefinitions="Auto,10,Auto,14,*,14,Auto">
                                <StackPanel Grid.Row="0"
                                            Spacing="4">
                                    <TextBlock Text="EXPORT VAULT"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />

                                    <TextBlock Text="Copies one complete encrypted vault from the current vault location."
                                               FontSize="11"
                                               LineHeight="16"
                                               Foreground="{StaticResource CriptyTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="LOCAL VAULT"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.3"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <ComboBox Grid.Row="4"
                                          ItemsSource="{Binding Vaults}"
                                          SelectedItem="{Binding SelectedExportVault, Mode=TwoWay}"
                                          VerticalAlignment="Top">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:VaultListItem">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Row="6"
                                        Classes="primary"
                                        Command="{Binding ExportVaultCommand}"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="EXPORT ENCRYPTED BACKUP"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="16"
                                Background="#09150F"
                                BorderBrush="{StaticResource CriptyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid RowDefinitions="Auto,10,*,12,Auto">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="IMPORT VAULT"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="1" />

                                        <TextBlock Text="Restores a backup into the current vault location."
                                                   FontSize="11"
                                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Padding="10,6"
                                            Command="{Binding RefreshCloudBackupsCommand}">
                                        <TextBlock Text="↻"
                                                   FontSize="16" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <ListBox ItemsSource="{Binding CloudBackups}"
                                             SelectedItem="{Binding SelectedCloudBackup, Mode=TwoWay}"
                                             MinHeight="150"
                                             MaxHeight="250">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="application:VaultBackupInfo">
                                                <StackPanel Margin="4"
                                                            Spacing="3">
                                                    <TextBlock Text="{Binding VaultName}"
                                                               FontWeight="SemiBold" />

                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="NO VALID BACKUPS FOUND"
                                               IsVisible="{Binding ShowNoCloudBackups}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.2"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </Grid>

                                <Button Grid.Row="4"
                                        Classes="info-action"
                                        Command="{Binding ImportVaultCommand}"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="IMPORT SELECTED BACKUP"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="6"
                            IsVisible="{Binding HasCloudError}"
                            Padding="11"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding CloudErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="6"
                            IsVisible="{Binding HasCloudStatus}"
                            Padding="11"
                            Background="#102331"
                            BorderBrush="{StaticResource CriptyInfoBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding CloudStatusMessage}"
                                   Foreground="{StaticResource CriptyInfoBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="8"
                               Text="The cloud provider only sees the already encrypted vault files and backup metadata."
                               HorizontalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                    <Border Grid.RowSpan="9"
                            IsVisible="{Binding IsCloudBusy}"
                            Background="#B807110D">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <ProgressBar Width="260"
                                         Height="3"
                                         IsIndeterminate="True" />

                            <TextBlock Text="VERIFYING ENCRYPTED VAULT FILES"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.3" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsReplaceConfirmationOpen}"
                Background="#E507110D">
            <Border Width="540"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Spacing="16">
                    <TextBlock Text="ANOTHER VERSION OF THIS VAULT ALREADY EXISTS"
                               FontSize="16"
                               FontWeight="SemiBold"
                               LetterSpacing="1"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Replacing it will not merge their changes. A complete encrypted recovery backup of the current version will be created first."
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{StaticResource CriptyTextMutedBrush}"
                               TextWrapping="Wrap" />

                    <Border Padding="14"
                            Background="#09150F"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding ReplacementCurrentGenerationText}" />
                            <TextBlock Text="{Binding ReplacementImportedGenerationText}"
                                       Foreground="{StaticResource CriptyInfoBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*">
                        <Button Classes="ghost"
                                Command="{Binding CancelReplaceVaultCommand}"
                                HorizontalContentAlignment="Center">
                            <TextBlock Text="CANCEL"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="danger"
                                Command="{Binding ConfirmReplaceVaultCommand}"
                                HorizontalContentAlignment="Center">
                            <TextBlock Text="REPLACE CURRENT VAULT"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
